<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find nvt_description)/urdf/utils/inertia.xacro" />
  <xacro:include filename="$(find nvt_description)/urdf/caster/caster_wheel.gazebo.xacro"/>

  <xacro:property name="wheel_radius" value="0.1575"/>
  <xacro:property name="wheel_length" value="0.032"/>
  <xacro:property name="wheel_mass" value="0.5"/>

  <xacro:macro name="caster_wheel_v0" params="prefix">
    <link name="${prefix}_caster_wheel_link">
      <visual>
		    <geometry>
		      <mesh filename="package://nvt_description/meshes/STL/caster/caster_wheel.stl"/>
		    </geometry>
		        
        <material name="black">
    		  <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
	    </visual>


      <collision>
		    <origin xyz="0 0 0" rpy="${-M_PI/2} 0 0"/>
		    <geometry>
		      <mesh filename="package://nvt_description/meshes/STL/caster/caster_wheel.stl"/>
		    </geometry>
      </collision>

      <inertial>
		    <origin xyz="0 -0.003 0" rpy="${-M_PI/2} 0 0"/>
		    <xacro:cylinder_inertia mass="0.5"
					radius="0.075" length="0.040"/>
	  	</inertial>
	        
      <!-- <inertial>
				<origin xyz="0 0 0"/>
				<mass value="0.5"/>
				<inertia ixx="0.1" ixy="0" ixz="0" iyy="0" iyz="0" izz="0.1" />
	    </inertial> -->
    </link>
  </xacro:macro>
</robot>
