<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  
  <xacro:macro name="caster_body_gazebo_v0" params="prefix">
	  <gazebo reference="${prefix}_caster_body_link">
	    <selfCollide> false </selfCollide>
      <mu1 value="0.8" />
      <mu2 value="0.8" />
    </gazebo>
  </xacro:macro>

</robot>
